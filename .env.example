# ---------------------------------------------------------------
# Copy this file to `.env` and fill in the values before running.
#   cp .env.example .env
# ---------------------------------------------------------------

# HTTP server
PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DATABASE=college_payment_portal

# Session signing secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=2h

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Leave TURNSTILE_SECRET empty to disable captcha verification in development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Simulated payment gateway.
# The project ships with a sandbox gateway so it runs without real credentials.
PAYMENT_GATEWAY=sandbox
PAYMENT_CURRENCY=INR
